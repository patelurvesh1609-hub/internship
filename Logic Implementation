<?php

namespace App\DTO;

use Illuminate\Http\Request;

class PropertyData
{
    public function __construct(
        public string $title,
        public int $category_id,
        public float $price,
        public ?string $description,
        public ?string $address,
        public ?string $city,
        public ?int $bedrooms,
        public ?int $bathrooms,
        public ?int $area_sqft,
        public string $status = 'active'
    ) {}

    public static function fromRequest(Request $request): self
    {
        return new self(
            title: $request->string('title')->toString(),
            category_id: (int)$request->input('category_id'),
            price: (float)$request->input('price'),
            description: $request->input('description'),
            address: $request->input('address'),
            city: $request->input('city'),
            bedrooms: $request->filled('bedrooms') ? (int)$request->input('bedrooms') : null,
            bathrooms: $request->filled('bathrooms') ? (int)$request->input('bathrooms') : null,
            area_sqft: $request->filled('area_sqft') ? (int)$request->input('area_sqft') : null,
            status: $request->input('status', 'active')
        );
    }

    public function toArray(): array
    {
        return [
            'title' => $this->title,
            'category_id' => $this->category_id,
            'price' => $this->price,
            'description' => $this->description,
            'address' => $this->address,
            'city' => $this->city,
            'bedrooms' => $this->bedrooms,
            'bathrooms' => $this->bathrooms,
            'area_sqft' => $this->area_sqft,
            'status' => $this->status,
        ];
    }
}
