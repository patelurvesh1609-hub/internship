<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\Cache;

class ClearProjectCacheCommand extends Command
{
    protected $signature = 'project:clear-cache';
    protected $description = 'Clear application cache used by project modules';

    public function handle(): int
    {
        Cache::forget('home_featured_properties');
        Cache::forget('admin_dashboard_stats');
        Cache::forget('all_categories_for_agent_form');

        $this->info('Project cache cleared successfully.');

        return self::SUCCESS;
    }
}
