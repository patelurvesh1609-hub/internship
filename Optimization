app/Observers/PropertyObserver.php
<?php

namespace App\Observers;

use App\Models\Property;
use Illuminate\Support\Facades\Cache;

class PropertyObserver
{
    public function created(Property $property): void
    {
        $this->clearCaches($property);
    }

    public function updated(Property $property): void
    {
        $this->clearCaches($property);
    }

    public function deleted(Property $property): void
    {
        $this->clearCaches($property);
    }

    protected function clearCaches(Property $property): void
    {
        Cache::forget('home_featured_properties');
        Cache::forget('admin_dashboard_stats');
        Cache::forget('agent_properties_' . $property->user_id);
        Cache::forget('property_details_' . $property->id);

        for ($i = 1; $i <= 20; $i++) {
            $cacheKey = 'user_properties_' . md5(json_encode([
                'page' => $i,
                'search' => '',
                'status' => 'active',
            ]));

            Cache::forget($cacheKey);
        }
    }
}
