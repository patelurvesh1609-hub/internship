<?php

namespace App\Http\Controllers;

use App\Models\Inquiry;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;

class AgentInquiryController extends Controller
{
    public function index()
    {
        $inquiries = Inquiry::with(['property','user'])
            ->where('agent_id', Auth::id())
            ->latest()
            ->paginate(10);

        return view('agent.inquiries.index', compact('inquiries'));
    }

    public function updateStatus(Request $request, Inquiry $inquiry)
    {
        abort_if($inquiry->agent_id !== Auth::id(), 403);

        $request->validate([
            'status' => 'required|in:pending,replied,closed'
        ]);

        $inquiry->update(['status' => $request->status]);

        return back()->with('success', 'Status updated.');
    }
}
