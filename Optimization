<?php

namespace App\Http\Controllers\Agent;

use App\Http\Controllers\Controller;
use App\Models\Category;
use App\Models\Property;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Storage;
use Illuminate\Validation\Rule;

class PropertyController extends Controller
{
    public function index()
    {
        $cacheKey = 'agent_properties_' . Auth::id();

        $properties = Cache::remember($cacheKey, now()->addMinutes(5), function () {
            return Property::with('category')
                ->where('user_id', Auth::id())
                ->latest()
                ->paginate(10);
        });

        return view('agent.properties.index', compact('properties'));
    }

    public function create()
    {
        $categories = Cache::remember('all_categories_for_agent_form', now()->addHours(1), function () {
            return Category::orderBy('name')->get();
        });

        return view('agent.properties.create', compact('categories'));
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'title' => ['required', 'string', 'max:150'],
            'description' => ['nullable', 'string', 'max:5000'],
            'price' => ['required', 'numeric', 'min:0'],
            'location' => ['required', 'string', 'max:150'],
            'status' => ['required', Rule::in(['active', 'inactive'])],
            'category_id' => ['nullable', 'exists:categories,id'],
            'image' => ['nullable', 'image', 'mimes:jpg,jpeg,png,webp', 'max:2048'],
        ]);

        if ($request->hasFile('image')) {
            $data['image'] = $request->file('image')->store('properties', 'public');
        }

        $data['user_id'] = Auth::id();

        Property::create($data);

        $this->clearPropertyCaches(Auth::id());

        return redirect()
            ->route('agent.properties.index')
            ->with('success', 'Property added successfully.');
    }

    public function edit(Property $property)
    {
        abort_unless($property->user_id === Auth::id(), 403);

        $categories = Cache::remember('all_categories_for_agent_form', now()->addHours(1), function () {
            return Category::orderBy('name')->get();
        });

        return view('agent.properties.edit', compact('property', 'categories'));
    }

    public function update(Request $request, Property $property)
    {
        abort_unless($property->user_id === Auth::id(), 403);

        $data = $request->validate([
            'title' => ['required', 'string', 'max:150'],
            'description' => ['nullable', 'string', 'max:5000'],
            'price' => ['required', 'numeric', 'min:0'],
            'location' => ['required', 'string', 'max:150'],
            'status' => ['required', Rule::in(['active', 'inactive'])],
            'category_id' => ['nullable', 'exists:categories,id'],
            'image' => ['nullable', 'image', 'mimes:jpg,jpeg,png,webp', 'max:2048'],
        ]);

        if ($request->hasFile('image')) {
            if ($property->image && Storage::disk('public')->exists($property->image)) {
                Storage::disk('public')->delete($property->image);
            }

            $data['image'] = $request->file('image')->store('properties', 'public');
        }

        $property->update($data);

        $this->clearPropertyCaches(Auth::id(), $property->id);

        return redirect()
            ->route('agent.properties.index')
            ->with('success', 'Property updated successfully.');
    }

    public function destroy(Property $property)
    {
        abort_unless($property->user_id === Auth::id(), 403);

        $propertyId = $property->id;

        if ($property->image && Storage::disk('public')->exists($property->image)) {
            Storage::disk('public')->delete($property->image);
        }

        $property->delete();

        $this->clearPropertyCaches(Auth::id(), $propertyId);

        return redirect()
            ->route('agent.properties.index')
            ->with('success', 'Property deleted successfully.');
    }

    protected function clearPropertyCaches(int $userId, ?int $propertyId = null): void
    {
        Cache::forget('agent_properties_' . $userId);
        Cache::forget('home_featured_properties');

        if ($propertyId) {
            Cache::forget('property_details_' . $propertyId);
        }

        for ($i = 1; $i <= 20; $i++) {
            $cacheKey = 'user_properties_' . md5(json_encode([
                'page' => $i,
                'search' => '',
                'status' => 'active',
            ]));

            Cache::forget($cacheKey);
        }
    }
}
