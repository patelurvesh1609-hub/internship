<?php

namespace App\Services\Property;

use Illuminate\Http\UploadedFile;
use Illuminate\Support\Facades\Storage;

class PropertyImageService
{
    private ?string $storedPath = null;

    public function storeMainImage(UploadedFile $file): string
    {
        $this->storedPath = $file->store('properties', 'public'); // storage/app/public/properties
        return $this->storedPath;
    }

    public function replaceMainImage(?string $oldPath, UploadedFile $newFile): void
    {
        if ($oldPath) {
            $this->deleteIfExists($oldPath);
        }
        $this->storeMainImage($newFile);
    }

    public function deleteIfExists(string $path): void
    {
        if (Storage::disk('public')->exists($path)) {
            Storage::disk('public')->delete($path);
        }
    }

    public function lastStoredPath(): ?string
    {
        return $this->storedPath;
    }
}
