<?php

namespace App\Services\Property;

use App\DTO\PropertyData;
use App\Models\Property;
use Illuminate\Support\Facades\DB;

class PropertyService
{
    public function __construct(
        private PropertyImageService $imageService
    ) {}

    public function create(PropertyData $data, int $agentId, $imageFile = null): Property
    {
        return DB::transaction(function () use ($data, $agentId, $imageFile) {

            // Real-world rule: agent can only create "pending" if your system requires admin approval
            // $payload = array_merge($data->toArray(), ['status' => 'pending']);
            $payload = $data->toArray();

            $property = Property::create(array_merge($payload, [
                'agent_id' => $agentId,
            ]));

            if ($imageFile) {
                $path = $this->imageService->storeMainImage($imageFile);
                $property->update(['image' => $path]); // change to your column: image/main_image
            }

            return $property;
        });
    }

    public function update(Property $property, PropertyData $data, $imageFile = null): Property
    {
        return DB::transaction(function () use ($property, $data, $imageFile) {

            $property->update($data->toArray());

            if ($imageFile) {
                // delete old image if exists
                $this->imageService->replaceMainImage($property->image, $imageFile);
                $property->update(['image' => $this->imageService->lastStoredPath()]);
            }

            return $property;
        });
    }

    public function delete(Property $property): void
    {
        DB::transaction(function () use ($property) {
            if (!empty($property->image)) {
                $this->imageService->deleteIfExists($property->image);
            }
            $property->delete();
        });
    }

    public function changeStatus(Property $property, string $status): Property
    {
        $allowed = ['active','inactive','pending'];
        abort_unless(in_array($status, $allowed, true), 422);

        $property->update(['status' => $status]);
        return $property;
    }
}
