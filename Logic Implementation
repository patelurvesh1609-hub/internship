<?php

namespace App\Services\Inquiry;

use App\Models\Inquiry;
use App\Models\Property;

class InquiryService
{
    public function create(Property $property, int $userId, array $payload): Inquiry
    {
        // Rule: inquiry always goes to the property agent
        return Inquiry::create([
            'property_id' => $property->id,
            'user_id'     => $userId,
            'agent_id'    => $property->agent_id,
            'name'        => $payload['name'],
            'email'       => $payload['email'],
            'phone'       => $payload['phone'] ?? null,
            'message'     => $payload['message'] ?? null,
            'status'      => 'pending',
        ]);
    }

    public function changeStatus(Inquiry $inquiry, int $agentId, string $status): Inquiry
    {
        abort_if($inquiry->agent_id !== $agentId, 403);

        $allowed = ['pending','replied','closed'];
        abort_unless(in_array($status, $allowed, true), 422);

        $inquiry->update(['status' => $status]);
        return $inquiry;
    }
}
